# CTest-generated output (regenerated on every ctest run)
Testing/

# python bytecode
__pycache__/
*.pyc

# demo: track the scripts and READMEs, not the regenerated case data.
# run_all.sh rebuilds case1024/case1M/out from scratch (~300 MB).
demo/amgpcg/case1024/
demo/amgpcg/case1M/
demo/amgpcg/out/

# delta: dictionaries + README only. The mesh, the time directories and the STL (licence unknown, see
# the case README) are all regenerated or user-supplied, so none of them are tracked.
demo/delta/[0-9]*/
!demo/delta/0.orig/
demo/delta/constant/polyMesh/
demo/delta/constant/extendedFeatureEdgeMesh/
demo/delta/constant/triSurface/*
!demo/delta/constant/triSurface/README

# wmake build output for the OpenFOAM oracle utilities under tools/. tools/dumpPEqn had its
# Make/linuxARM64GccDPInt32Opt/ committed by accident; nothing regenerates from it and nothing reads it.
tools/*/Make/linux*/

.claude/*
manifest/*
CLAUDE.md
src/applications/solvers/rhoSimpleFoam/PORT.md
src/applications/solvers/rhoSimpleFoam/REFUSALS.md
bench/rhoSimpleFoam/FASTPATH.md
!validation/slipTurb
.rho_h_plans.md

# spuma's extrapolated numbers are projections, not measurements, and are kept out of the repo so they
# can never be mistaken for the measured benchmark walls beside them (asked 2026-09-14).
bench/rhoSimpleFoam/spuma_extrapolation/

# The clip renderers are pvbatch scripts for making videos, not part of the port or its validation.
# They live beside the visual runs in ~/space and are kept out of the repo (asked 2026-09-15).
bench/rhoSimpleFoam/render_*.py
